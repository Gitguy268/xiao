import { Image } from 'astro:assets'
import startDark from '../../assets/start-dark.png'
import startLight from '../../assets/start-light.png'
import Layout from '../../layouts/Layout.astro'
import { localePaths, url } from '../../lib/site'
import { readList } from '../../lib/prefs'

export const getStaticPaths = localePaths
const prefCount = readList('balanced').length
const alt = 'The xiao start page: a greeting, a search field, a few site links, and a line saying how many ads and trackers were blocked and whether Tor is connected.'
---

<Layout title="xiao: a calm browser with the doors locked" isHome>
  <section class="hero">
    <h1>A calm browser,<br />doors locked.</h1>
    <p class="lead">
      xiao is built on Zen Browser, with ad and tracker blocking built in, its privacy settings turned up, and tabs
      that go through Tor when you ask for them. For macOS, Windows and Linux.
    </p>
    <div class="actions">
      <a class="button primary" href={url('download/')}>Download xiao</a>
      <a class="button" href={url('privacy/')}>See every setting it changes</a>
    </div>
  </section>

  <figure class="shot">
    <Image class="only-light" src={startLight} alt={alt} widths={[720, 1440]} sizes="(max-width: 1180px) 100vw, 1180px" loading="eager" />
    <Image class="only-dark" src={startDark} alt={alt} widths={[720, 1440]} sizes="(max-width: 1180px) 100vw, 1180px" />
    <figcaption>The start page works offline and tells you what was blocked.</figcaption>
  </figure>

  <section class="changes" aria-labelledby="changes-title">
    <h2 id="changes-title" class="visually-hidden">What xiao changes</h2>
    <div class="change">
      <h3>Ads and trackers are blocked before they load.</h3>
      <div>
        <p>
          xiao uses Ghostery's open-source blocking engine with EasyList, EasyPrivacy and uBlock Origin's lists, refreshed
          every day. It hides empty ad slots too. If a site breaks, switch blocking off for that site from the toolbar.
        </p>
        <p class="muted">Prefer uBlock Origin? The installer can add it alongside.</p>
      </div>
    </div>
    <div class="change">
      <h3>Privacy settings start where most people would end.</h3>
      <div>
        <p>
          {prefCount} settings change from the moment you open it: no telemetry or studies, strict tracking protection,
          HTTPS only, encrypted DNS, no early connections to sites you haven't opened, and WebRTC that can't reveal your
          local network.
        </p>
        <p class="muted">Strict mode adds Tor Browser's fingerprinting resistance, for sites that try to recognise you.</p>
      </div>
    </div>
    <div class="change">
      <h3>Tor when you want it, and only then.</h3>
      <div>
        <p>
          Open a Tor tab and it goes through the Tor network, with a separate circuit for each site. If Tor stops, those
          tabs stop too. They never fall back to a direct connection. Your other tabs stay on your normal connection.
        </p>
        <p class="muted">
          This hides your IP address from sites. It doesn't make you look like every other Tor Browser user, so when that
          matters, use Tor Browser.
        </p>
      </div>
    </div>
  </section>

  <section class="ways" aria-labelledby="ways-title">
    <h2 id="ways-title">Two ways to run it</h2>
    <div class="table-scroll">
      <table>
        <thead>
          <tr><th scope="col"></th><th scope="col">The kit</th><th scope="col">The build</th></tr>
        </thead>
        <tbody>
          <tr><th scope="row">What it is</th><td>Adds xiao to the Zen you already have, in a profile of its own. Your normal Zen is left alone.</td><td>Zen's source, renamed and rebuilt with everything inside.</td></tr>
          <tr><th scope="row">Available</th><td>Now</td><td>Built by GitHub Actions from this repository; macOS builds are not notarised yet.</td></tr>
          <tr><th scope="row">Updates</th><td>Run the installer again for a new xiao. On macOS xiao is its own copy of Zen and rebuilds itself when Zen updates.</td><td>Download each new release.</td></tr>
          <tr><th scope="row">Tor</th><td>Tor tabs; the installer downloads Tor and the launcher runs it</td><td>Tor tabs if a tor is already running on port 9160; built-in Tor is planned</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="limits" aria-labelledby="limits-title">
    <h2 id="limits-title">What it doesn't do</h2>
    <ul>
      <li>It doesn't make you anonymous. Tor tabs hide your address, but the browser itself is still recognisable as xiao.</li>
      <li>It doesn't block everything. Filter lists catch most ads and trackers, not all, and a few sites need blocking switched off to work.</li>
      <li>It isn't audited. The settings come from well-known projects, but no one has reviewed xiao as a whole.</li>
    </ul>
  </section>
</Layout>
