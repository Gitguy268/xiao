import Layout from '../../layouts/Layout.astro'
import { localePaths, REPO } from '../../lib/site'

export const getStaticPaths = localePaths
---

<Layout title="About Xiao" description="Why Xiao exists and whose work it is built on.">
  <section class="page">
    <h1>About <em>Xiao</em></h1>
    <p class="lead">
      Zen is a calm, well-made browser. Xiao keeps all of that and adds the protection people otherwise put together by
      hand: a blocker, a long list of privacy settings, a way to send some tabs through Tor, and a search of your own.
    </p>
    <p class="prose">
      The name is Mandarin for small. Xiao is a small layer on top of other people's work, and it tries to stay that way:
      a few hundred lines of browser code, settings files, and the scripts that put them into Zen.
    </p>

    <h2>Built on</h2>
    <ul class="credits">
      <li><a href="https://github.com/zen-browser/desktop">Zen Browser</a> and its build tool <a href="https://github.com/zen-browser/surfer">surfer</a>, MPL 2.0</li>
      <li><a href="https://github.com/zen-browser/www">Zen's website</a>, the starting point for this one's structure and layout, MPL 2.0</li>
      <li><a href="https://www.mozilla.org/firefox/">Firefox</a>, MPL 2.0</li>
      <li><a href="https://github.com/ghostery/adblocker">Ghostery's adblocker</a>, MPL 2.0</li>
      <li><a href="https://www.torproject.org/">Tor</a>, BSD 3-Clause, downloaded at install time; Tor Browser's circuit-per-site idea</li>
      <li><a href="https://github.com/searxng/searxng">SearXNG</a>, AGPL 3.0, downloaded at install time for Xiao Search</li>
      <li><a href="https://github.com/mullvad/mullvad-browser">Mullvad Browser</a> and Tor Browser's hardening, MPL 2.0 (ideas)</li>
      <li><a href="https://github.com/BrowserWorks/waterfox">Waterfox</a>'s privacy defaults, MPL 2.0 (ideas)</li>
      <li><a href="https://github.com/arkenfox/user.js">arkenfox</a>, <a href="https://github.com/yokoffing/Betterfox">Betterfox</a> and <a href="https://github.com/Eratas/rapidfox">rapidfox</a>, MIT and CC0 (ideas)</li>
      <li><a href="https://github.com/chocobuckle/optimisation">chocobuckle's</a> page-speed notes and <a href="https://github.com/rodneylab/open-source-favicon-generation">rodneylab's</a> favicon set, MIT and BSD (ideas)</li>
      <li>Bricolage Grotesque and Junicode, SIL Open Font License</li>
      <li>The look takes cues from <a href="https://zen-browser.app">zen-browser.app</a> and <a href="https://thebrowser.company/">The Browser Company</a>'s site (ideas only)</li>
    </ul>

    <h2>Licence</h2>
    <p class="prose">
      Xiao is free software under the <a href="https://www.mozilla.org/MPL/2.0/">Mozilla Public License 2.0</a>. The
      <a href={REPO}>source is on GitHub</a>. Xiao is not affiliated with or endorsed by Zen, Mozilla, Mullvad, the Tor
      Project, Ghostery, SearXNG or The Browser Company. Their names are trademarks of their owners.
    </p>
  </section>
</Layout>
