{
  "name": "xiao",
  "version": "0.1.0",
  "private": true,
  "description": "A hardened Zen browser: built-in ad and tracker blocking, Tor tabs, and a calm start page.",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/",
    "e2e": "node test/e2e/run.mjs",
    "site:assets": "node scripts/site-assets.mjs",
    "site:dev": "npm run site:assets && astro dev --root site --port 4321",
    "site:build": "npm run site:assets && astro build --root site"
  },
  "dependencies": {
    "@ghostery/adblocker-webextension": "^2.20.1",
    "@ghostery/adblocker-webextension-cosmetics": "^2.20.1"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "astro": "^7.3.6",
    "esbuild": "^0.28.2",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.2"
  },
  "homepage": "https://gitguy268.github.io/xiao/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gitguy268/xiao"
  },
  "author": "Lucas Van De Weerd"
}
