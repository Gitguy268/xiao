// Same idea as zen-browser/www's ThemeSwitch: remember the choice, else follow the system.
import { getUI } from '../lib/site'
const { theme } = getUI(Astro.currentLocale)
---

<button class="theme" type="button" data-light={theme.toLight} data-dark={theme.toDark} aria-label={theme.toDark}>
  <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
    <circle cx="10" cy="10" r="7.5" fill="none" stroke="currentColor" stroke-width="1.5" />
    <path d="M10 2.5a7.5 7.5 0 0 1 0 15z" fill="currentColor" />
  </svg>
</button>

<script>
  const button = document.querySelector<HTMLButtonElement>('button.theme')!
  const isDark = () =>
    document.documentElement.dataset.theme === 'dark' ||
    (!document.documentElement.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches)
  const label = () => button.setAttribute('aria-label', isDark() ? button.dataset.light! : button.dataset.dark!)
  label()
  button.addEventListener('click', () => {
    const next = isDark() ? 'light' : 'dark'
    document.documentElement.dataset.theme = next
    try {
      localStorage.setItem('theme', next)
    } catch {}
    label()
  })
</script>
