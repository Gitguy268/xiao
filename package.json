{
  "name": "xiao",
  "version": "0.6.1",
  "private": true,
  "description": "A hardened Zen browser: built-in ad and tracker blocking, Tor tabs, and a calm start page.",
  "license": "MPL-2.0",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/*.test.mjs\"",
    "e2e": "node test/e2e/run.mjs",
    "e2e:upgrade": "node test/e2e/upgrade.mjs",
    "e2e:new": "node test/e2e/new-features.mjs",
    "e2e:audit": "node test/e2e/network-audit.mjs",
    "packs": "node scripts/packs.mjs",
    "bangs": "node scripts/bangs.mjs",
    "site:assets": "node scripts/site-assets.mjs",
    "site:dev": "npm run site:assets && astro dev --root site --port 4321",
    "site:build": "npm run site:assets && astro build --root site"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@cantoo/pdf-lib": "^2.11.1",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "astro": "^7.3.6",
    "esbuild": "^0.28.2",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=22.2"
  },
  "homepage": "https://gitguy268.github.io/xiao/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Gitguy268/xiao"
  },
  "author": "Lucas Van De Weerd",
  "dependencies": {
    "@ghostery/adblocker": "^2.20.1",
    "@ghostery/adblocker-content": "^2.20.1",
    "@ghostery/adblocker-extended-selectors": "^2.20.1"
  }
}
